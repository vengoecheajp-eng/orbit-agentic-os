# Gemini is optional. It enables planning/research tasks through Gemini API.
GEMINI_API_KEY=
# Optional for private GitHub repos and higher GitHub API limits. Keep this local.
GITHUB_TOKEN=
# Optional production deployment tokens. Orbit reads these only from this local file
# and asks for an explicit confirmation before invoking a deployment CLI.
VERCEL_TOKEN=
NETLIFY_AUTH_TOKEN=
CLOUDFLARE_API_TOKEN=
RAILWAY_TOKEN=
# Claude defaults are deliberately economical. Opus is a manual finish gate only.
ORBIT_CLAUDE_MODEL=sonnet
ORBIT_CLAUDE_EFFORT=medium
ORBIT_CLAUDE_MAX_BUDGET_USD=2
# Local Ollama provider: context stays entirely on this Mac.
ORBIT_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
ORBIT_LOCAL_MODEL=qwen2.5-coder:14b
# Port used by the Orbit local control plane.
PORT=8787

# Optional: keep your personal profile, repository records, run history, skills,
# and provider preferences outside the Orbit source folder. Use an absolute path.
# Run `npm run personal:migrate-data -- --to "$HOME/.orbit/personal"` first.
# ORBIT_DATA_DIR=/absolute/path/to/.orbit/personal

# Optional: Completion Gate limits (milliseconds). Rust, Java, .NET, and Swift
# checks use the slow limit.
# ORBIT_GATE_TIMEOUT_MS=180000
# ORBIT_GATE_SLOW_TIMEOUT_MS=900000
# ORBIT_INSTALL_TIMEOUT_MS=300000
# Optional: dependency review. Set lookups to off without internet access.
# ORBIT_REGISTRY_LOOKUPS=on
# ORBIT_NPM_REGISTRY=https://registry.npmjs.org
# Optional: Codex model, Vite dev port, and a self-hosted Telegram Bot API server.
# ORBIT_CODEX_MODEL=
# ORBIT_DEV_PORT=5173
# ORBIT_TELEGRAM_API_BASE=https://api.telegram.org
